<Window x:Class="Akinti.Ui.DoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Akıntı" Width="392" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{StaticResource B.Bg}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource B.Neutral800}" BorderThickness="1"
            Background="{StaticResource B.Bg}">
        <StackPanel Margin="14,10,10,14">

            <!-- ═══ Başlık ═══ -->
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent"
                  Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="IcoState" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}"
                               FontSize="12" Foreground="{StaticResource B.Accent}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtHeader" Text="İndirme tamamlandı" Margin="9,0,0,0"
                               FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Btn.CaptionClose}" HorizontalAlignment="Right"
                        Width="32" Height="26" Click="BtnClose_Click">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- ═══ Dosya ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FileTile}" VerticalAlignment="Center">
                    <TextBlock x:Name="IcoFile" Text="&#xE7C3;" Style="{StaticResource T.Icon}"
                               FontSize="15" Foreground="{StaticResource B.Accent}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtName" Text="—" FontSize="13" FontWeight="Medium"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <!-- ═══ Konum / hata ═══ -->
            <TextBlock x:Name="TxtDetail" Style="{StaticResource T.Meta}" Margin="0,12,0,0"
                       TextWrapping="Wrap" />

            <!-- ═══ Alt sıra ═══ -->
            <Grid Margin="0,16,0,0">
                <TextBlock x:Name="TxtNote" Style="{StaticResource T.Meta}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,180,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnOpenFile" Style="{StaticResource Btn.Ghost}" Content="Dosyayı aç"
                            Padding="10,6" Margin="0,0,8,0" Click="BtnOpenFile_Click" />
                    <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Primary}" Content="Klasörü aç"
                            Padding="12,6" Click="BtnOpenFolder_Click" />
                </StackPanel>
            </Grid>

        </StackPanel>
    </Border>
</Window>

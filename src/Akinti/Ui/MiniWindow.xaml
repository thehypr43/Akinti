<Window x:Class="Akinti.Ui.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndiriliyor" Width="468" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="16,14,16,16">

        <!-- ═══ Dosya ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="44" Height="44"
                    VerticalAlignment="Center">
                <TextBlock x:Name="IcoFile" Text="&#xE7C3;" Style="{StaticResource T.Icon}"
                           FontSize="17" Foreground="{DynamicResource B.TextMuted}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtName" Text="—" FontSize="15" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2" x:Name="TxtPct" Text="0%" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Maximum="100" Value="0"
                     Height="4" Margin="0,14,0,0" />

        <!-- ═══ Sayılar ═══ -->
        <Border x:Name="PnlStats" Margin="0,14,0,0" Padding="14,12" CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Neutral800}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PARÇA" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtParts" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="KALAN" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtRemaining" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="HIZ" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtSpeed" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="KALAN SÜRE" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtEta" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Alt sıra ═══ -->
        <Grid Margin="0,12,0,0">
            <TextBlock x:Name="TxtNote" Style="{StaticResource T.Meta}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="2,0,90,0" />
            <StackPanel x:Name="PnlActions" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnExpand" Style="{StaticResource Btn.Icon}" Width="32" Height="32"
                        Click="BtnExpand_Click" ToolTip="Ana pencereyi aç">
                    <TextBlock Text="&#xE740;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="BtnToggle" Style="{StaticResource Btn.Icon}" Width="32" Height="32"
                        Click="BtnToggle_Click" ToolTip="Duraklat / devam et">
                    <TextBlock x:Name="IcoToggle" Text="&#xE769;" FontFamily="{StaticResource F.Icon}"
                               FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="BtnCancel" Style="{StaticResource Btn.Icon}" Width="32" Height="32"
                        Click="BtnCancel_Click" ToolTip="İndirmeyi iptal et">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>

<Window x:Class="Akinti.Ui.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndiriliyor" Width="356" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Mica}"
        Foreground="{DynamicResource B.Text}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Tasarimdaki "İndiriliyor" diyalogu: 356 genislik, ustte yuzde ve kalan
         sure, altinda 6px cubuk, sonra 2x2 bilgi izgarasi ve dugmeler. -->
    <StackPanel Margin="22,12,22,22">

        <!-- ═══ Başlık ═══ -->
        <StackPanel>
            <TextBlock x:Name="TxtHeadline" Text="—" Style="{StaticResource T.H5}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtName" Text="—" Style="{StaticResource T.Muted}" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <!-- ═══ İlerleme ═══ -->
        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Height="6" Maximum="100" Value="0"
                     Margin="0,18,0,0" />
        <Grid Margin="0,8,0,0">
            <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtSpeed" Style="{StaticResource T.Meta}" HorizontalAlignment="Right" />
        </Grid>

        <!-- ═══ Bilgi ızgarası ═══ -->
        <Border x:Name="PnlStats" Margin="0,18,0,0" CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.Neutral800}"
                BorderBrush="{DynamicResource B.Neutral800}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource B.Surface}"
                        Margin="0,0,1,1" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="BAĞLANTI" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtParts" Text="—" Style="{StaticResource T.Value}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource B.Surface}"
                        Margin="0,0,0,1" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="GEÇEN SÜRE" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtElapsed" Text="—" Style="{StaticResource T.Value}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource B.Surface}"
                        Margin="0,0,1,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="SUNUCU" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtHost" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource B.Surface}"
                        Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="KONUM" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtFolder" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtNote" Style="{StaticResource T.Meta}" Margin="2,12,0,0"
                   TextTrimming="CharacterEllipsis" />

        <!-- ═══ Eylemler ═══ -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnToggle" Style="{StaticResource Btn.Secondary}"
                    Height="34" MinHeight="34" Margin="0,0,8,0" Click="BtnToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IcoToggle" Text="&#xE769;" FontFamily="{StaticResource F.Icon}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock x:Name="TxtToggle" Text="Duraklat" Margin="8,0,0,0" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" x:Name="BtnCancel" Style="{StaticResource Btn.Ghost}"
                    Content="İptal et" Height="34" MinHeight="34" Margin="0,0,8,0"
                    Click="BtnCancel_Click" />

            <Button Grid.Column="2" x:Name="BtnExpand" Style="{StaticResource Btn.Secondary}"
                    Width="34" Height="34" MinHeight="34" Padding="0" Click="BtnExpand_Click"
                    ToolTip="Ana pencereyi aç">
                <TextBlock Text="&#xE740;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

    </StackPanel>
</Window>

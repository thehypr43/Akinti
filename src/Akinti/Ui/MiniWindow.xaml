<Window x:Class="Akinti.Ui.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndiriliyor" Width="380" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Mica}"
        Foreground="{DynamicResource B.Text}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Ustte dosya kimligi ve yuzde, ortada cubuk, altta sayilar. Sayilar
         basligin icine sikistirilmiyor: dort deger de kartta, ayni olcude. -->
    <StackPanel Margin="22,14,22,22">

        <!-- ═══ Dosya ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="40" Height="40"
                    VerticalAlignment="Center">
                <TextBlock x:Name="TxtKind" Text="DSY" Style="{StaticResource T.FileKind}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtName" Text="—" FontSize="14" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <TextBlock Grid.Column="2" x:Name="TxtPct" Text="%0"
                       FontFamily="{StaticResource F.Display}" FontSize="22" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- ═══ İlerleme ═══ -->
        <ProgressBar x:Name="Bar" Style="{StaticResource Bar}" Height="6" Maximum="100" Value="0"
                     Margin="0,16,0,0" />

        <!-- ═══ Sayılar ═══ -->
        <Border x:Name="PnlStats" Margin="0,16,0,0" CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.Neutral800}"
                BorderBrush="{DynamicResource B.Neutral800}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource B.Surface}"
                        Margin="0,0,1,1" Padding="14,11">
                    <StackPanel>
                        <TextBlock Text="HIZ" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtSpeed" Text="—" Style="{StaticResource T.Value}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource B.Surface}"
                        Margin="0,0,0,1" Padding="14,11">
                    <StackPanel>
                        <TextBlock Text="KALAN SÜRE" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtEta" Text="—" Style="{StaticResource T.Value}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource B.Surface}"
                        Margin="0,0,1,0" Padding="14,11">
                    <StackPanel>
                        <TextBlock Text="KALAN" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtRemaining" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource B.Surface}"
                        Padding="14,11">
                    <StackPanel>
                        <TextBlock Text="PARÇA" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtParts" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock x:Name="TxtNote" Style="{StaticResource T.Meta}" Margin="2,12,0,0"
                   TextTrimming="CharacterEllipsis" />

        <!-- ═══ Eylemler ═══ -->
        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnToggle" Style="{StaticResource Btn.Secondary}"
                    Height="34" MinHeight="34" Margin="0,0,8,0" Click="BtnToggle_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="IcoToggle" Text="&#xE769;" FontFamily="{StaticResource F.Icon}"
                               FontSize="12" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock x:Name="TxtToggle" Text="Duraklat" Margin="8,0,0,0" FontSize="14"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </StackPanel>
            </Button>

            <Button Grid.Column="1" x:Name="BtnCancel" Style="{StaticResource Btn.Ghost}"
                    Content="İptal et" Height="34" MinHeight="34" Margin="0,0,8,0"
                    Click="BtnCancel_Click" />

            <Button Grid.Column="2" x:Name="BtnExpand" Style="{StaticResource Btn.Secondary}"
                    Width="34" Height="34" MinHeight="34" Padding="0" Click="BtnExpand_Click"
                    ToolTip="Ana pencereyi aç">
                <TextBlock Text="&#xE740;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

    </StackPanel>
</Window>

<Window x:Class="HafifDM.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HafifDM" Height="620" Width="1000" MinHeight="420" MinWidth="760"
        Icon="/hafifdm.ico"
        Background="{StaticResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="186" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sol kenar ================= -->
        <Border Grid.Column="0" Background="{StaticResource B.Surface}"
                BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="HafifDM" Style="{StaticResource T.Title}"
                           Margin="10,6,0,16" />

                <Button DockPanel.Dock="Bottom" x:Name="BtnSettings" Content="Ayarlar"
                        Click="BtnSettings_Click" Margin="0,10,0,0" />

                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="10">
                    <StackPanel>
                        <TextBlock x:Name="TxtEngine" Text="Motor kontrol ediliyor..."
                                   Style="{StaticResource T.Dim}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtTotalSpeed" Text="" Style="{StaticResource T.Dim}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavAll"       Style="{StaticResource Btn.Nav}" Content="Tumu"
                                 IsChecked="True" Checked="Nav_Checked" Tag="All" />
                    <RadioButton x:Name="NavActive"    Style="{StaticResource Btn.Nav}" Content="Devam eden"
                                 Checked="Nav_Checked" Tag="Active" />
                    <RadioButton x:Name="NavCompleted" Style="{StaticResource Btn.Nav}" Content="Tamamlanan"
                                 Checked="Nav_Checked" Tag="Completed" />
                    <RadioButton x:Name="NavFailed"    Style="{StaticResource Btn.Nav}" Content="Basarisiz"
                                 Checked="Nav_Checked" Tag="Failed" />
                    <RadioButton x:Name="NavTorrent"   Style="{StaticResource Btn.Nav}" Content="Torrent"
                                 Checked="Nav_Checked" Tag="Torrent" />
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- ================= Sag icerik ================= -->
        <DockPanel Grid.Column="1" Margin="16">

            <!-- Arac cubugu -->
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button Style="{StaticResource Btn.Primary}" Content="Yeni indirme"
                        Click="BtnNew_Click" Margin="0,0,8,6" />
                <Button x:Name="BtnPause"  Content="Duraklat"    Click="BtnPause_Click"  Margin="0,0,8,6" />
                <Button x:Name="BtnResume" Content="Devam"       Click="BtnResume_Click" Margin="0,0,8,6" />
                <Button x:Name="BtnCancel" Content="Iptal"       Click="BtnCancel_Click" Margin="0,0,8,6" />
                <Button x:Name="BtnRetry"  Content="Yeniden dene" Click="BtnRetry_Click" Margin="0,0,8,6" />
                <Button x:Name="BtnOpen"   Content="Klasoru ac"  Click="BtnOpen_Click"   Margin="0,0,8,6" />
                <Button x:Name="BtnRemove" Content="Listeden sil" Click="BtnRemove_Click" Margin="0,0,0,6" />
            </WrapPanel>

            <!-- Bos durum -->
            <TextBlock x:Name="TxtEmpty" DockPanel.Dock="Top" Visibility="Collapsed"
                       Style="{StaticResource T.Dim}" Margin="4,24,0,0"
                       Text="Burada henuz bir sey yok. Tarayicida bir baglantiya sag tiklayip
                             &quot;HafifDM ile indir&quot; secebilir veya yukaridaki Yeni indirme dugmesini kullanabilirsin."
                       TextWrapping="Wrap" />

            <ListView x:Name="List" Background="Transparent" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      SelectionChanged="List_SelectionChanged"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="bd" Background="{StaticResource B.Surface}"
                                            BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                            CornerRadius="{StaticResource R.CornerRadius}" Padding="14,11">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="{StaticResource B.SurfaceAlt}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="bd" Property="BorderBrush"
                                                    Value="{StaticResource B.Accent}" />
                                            <Setter TargetName="bd" Property="Background"
                                                    Value="{StaticResource B.SurfaceAlt}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StateText}"
                                       Style="{StaticResource T.Dim}" Margin="12,0,0,0" />

                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Bar}"
                                         Value="{Binding Percent, Mode=OneWay}" Maximum="100"
                                         Margin="0,8,0,7" />

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding SubText}"
                                       Style="{StaticResource T.Dim}" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Klasoru ac"               Click="BtnOpen_Click" />
                        <MenuItem Header="Arsivi cikar"             Click="CtxExtract_Click" />
                        <MenuItem Header="Yonetici olarak calistir" Click="CtxRunAdmin_Click" />
                        <Separator />
                        <MenuItem Header="Adresi kopyala"           Click="CtxCopyUrl_Click" />
                        <MenuItem Header="Torrent hash kopyala"     Click="CtxCopyHash_Click" />
                        <Separator />
                        <MenuItem Header="Listeden sil"             Click="BtnRemove_Click" />
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </DockPanel>
    </Grid>
</Window>

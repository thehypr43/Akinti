{
  "manifest_version": 3,
  "name": "Akıntı",
  "version": "1.1.1",
  "description": "Chrome indirmelerini Akıntı'ya yönlendirir. Sayfalara hiçbir şekilde dokunmaz.",

  "permissions": ["contextMenus", "nativeMessaging", "downloads", "storage"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Akıntı",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

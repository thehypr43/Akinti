<Window x:Class="Akinti.Ui.TorrentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torrent" Height="600" Width="720" MinHeight="460" MinWidth="560"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <DockPanel Margin="18,14,18,16">

        <!-- ═══ Üst: ad, durum, yüzde ═══ -->
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="44" Height="44"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE896;" Style="{StaticResource T.Icon}" FontSize="17"
                           Foreground="{DynamicResource B.Accent}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtName" Text="—" FontSize="16" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPct" Text="0%" FontSize="22" FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <Border x:Name="TagState" Style="{StaticResource Tag}" Margin="0,4,0,0"
                        HorizontalAlignment="Right"
                        Background="{DynamicResource B.AccentSubtle}">
                    <TextBlock x:Name="TxtState" Text="Bilgiler bekleniyor"
                               Style="{StaticResource T.TagText}"
                               Foreground="{DynamicResource B.Accent}" />
                </Border>
            </StackPanel>
        </Grid>

        <ProgressBar x:Name="Bar" DockPanel.Dock="Top" Style="{StaticResource Bar}" Height="4"
                     Maximum="100" Value="0" Margin="0,14,0,0" />

        <!-- ═══ Torrent sayıları ═══ -->
        <Border DockPanel.Dock="Top" Margin="0,14,0,0" Padding="14,12"
                CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.Surface}"
                BorderBrush="{DynamicResource B.Neutral800}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="TOHUM" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtSeeders" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="BAĞLI EŞ" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtPeers" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="İNDİRME" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtDown" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3">
                    <TextBlock Text="YÜKLEME" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtUp" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                    <TextBlock Text="PAYLAŞIM ORANI" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtRatio" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                    <TextBlock Text="PAYLAŞILAN" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtUploaded" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                    <TextBlock Text="KALAN" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtRemaining" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,14,0,0">
                    <TextBlock Text="KALAN SÜRE" Style="{StaticResource T.SectionLabel}" />
                    <TextBlock x:Name="TxtEta" Text="—" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Alt sıra ═══ -->
        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnToggle" Style="{StaticResource Btn.Secondary}" Content="Duraklat"
                        Click="BtnToggle_Click" MinWidth="96" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="BtnStopSeed" Style="{StaticResource Btn.Secondary}"
                        Content="Paylaşımı durdur" Click="BtnStopSeed_Click" Padding="12,7"
                        Margin="0,0,8,0" />
                <Button x:Name="BtnFolder" Style="{StaticResource Btn.Secondary}" Content="Klasör"
                        Click="BtnFolder_Click" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="BtnCopyMagnet" Style="{StaticResource Btn.Ghost}" Content="Magnet kopyala"
                        Click="BtnCopyMagnet_Click" Padding="8,7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="Kapat" Click="BtnClose_Click"
                        MinWidth="86" Padding="12,7" Margin="0,0,9,0" />
                <Button x:Name="BtnApply" Style="{StaticResource Btn.Primary}" Content="Seçimi uygula"
                        Click="BtnApply_Click" IsEnabled="False" MinWidth="118" Padding="12,7" />
            </StackPanel>
        </Grid>

        <!-- ═══ Dosyalar ═══ -->
        <Grid DockPanel.Dock="Top" Margin="0,16,0,0">
            <TextBlock x:Name="TxtFilesLabel" Text="DOSYALAR" Style="{StaticResource T.SectionLabel}"
                       VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Ghost}" Content="Tümü" Click="BtnAll_Click"
                        Padding="8,3" Margin="0,0,4,0" />
                <Button Style="{StaticResource Btn.Ghost}" Content="Hiçbiri" Click="BtnNone_Click"
                        Padding="8,3" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Margin="0,8,0,0" Padding="4">
            <Grid>
                <TextBlock x:Name="TxtFilesEmpty" Style="{StaticResource T.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           Margin="24" TextAlignment="Center"
                           Text="Torrent bilgileri bekleniyor. Dosya listesi gelir gelmez burada görünecek; seçim yapmazsan hepsi iner." />

                <ListBox x:Name="ListFiles" Style="{StaticResource List.Plain}" Visibility="Collapsed">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" Padding="8,5"
                                                CornerRadius="{StaticResource R.Sm}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{DynamicResource B.ZebraFill}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                          Content="{Binding Display}" VerticalAlignment="Center" Margin="0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PercentText}"
                                           Style="{StaticResource T.Meta}" Margin="12,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SizeText}"
                                           Style="{StaticResource T.Meta}" Margin="12,0,4,0"
                                           VerticalAlignment="Center" />

                                <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource Bar}"
                                             Height="3" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                             Margin="24,5,4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </DockPanel>
</Window>

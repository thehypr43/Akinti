<Window x:Class="Akinti.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ayarlar" Height="700" Width="700" MinHeight="520" MinWidth="600"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        WindowStartupLocation="CenterOwner"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <DockPanel>

        <Grid DockPanel.Dock="Bottom" Margin="20,12,20,18">
            <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Meta}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,200,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="İptal" Click="BtnCancel_Click"
                        MinWidth="88" Padding="12,7" Margin="0,0,9,0" />
                <Button Style="{StaticResource Btn.Primary}" Content="Kaydet" Click="BtnSave_Click"
                        IsDefault="True" MinWidth="96" Padding="12,7" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="20,14,6,0">
            <StackPanel Margin="0,0,14,0">

                <TextBlock Text="Ayarlar" Style="{StaticResource T.H4}" />
                <TextBlock Text="Bant genişliği, bağlantılar ve dosyaların indiği yer."
                           Style="{StaticResource T.Muted}" Margin="0,2,0,16" />

                <!-- ═══ Klasorler ═══ -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="KLASÖRLER" Style="{StaticResource T.Kicker}" Margin="0,0,0,12" />

                        <TextBlock Text="İndirme klasörü" Style="{StaticResource T.Meta}" Margin="0,0,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtDownloadDir" Grid.Column="0" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Seç…"
                                    Click="BtnBrowseDownloadDir_Click" Margin="9,0,0,0" Padding="12,7" />
                        </Grid>

                        <TextBlock Text="Her dosya doğrudan bu klasöre iner. Türe göre otomatik alt klasör yok; klasörü indirme penceresinden tek tek değiştirebilirsin."
                                   Style="{StaticResource T.Meta}" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ═══ Hiz ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="HIZ" Style="{StaticResource T.Kicker}" Margin="0,0,0,12" />

                        <TextBlock Text="Eşzamanlı indirme" Style="{StaticResource T.Meta}" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Seg}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Seg1" Style="{StaticResource Seg.Opt}" Content="1"
                                             GroupName="conc" />
                                <RadioButton x:Name="Seg2" Style="{StaticResource Seg.Opt}" Content="2"
                                             GroupName="conc" />
                                <RadioButton x:Name="Seg3" Style="{StaticResource Seg.Opt}" Content="3"
                                             GroupName="conc" />
                                <RadioButton x:Name="Seg4" Style="{StaticResource Seg.Opt}" Content="4"
                                             GroupName="conc" />
                                <RadioButton x:Name="Seg8" Style="{StaticResource Seg.Opt}" Content="8"
                                             GroupName="conc" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Dosya başına bağlantı" Style="{StaticResource T.Meta}"
                                           Margin="0,0,0,5" />
                                <TextBox x:Name="TxtConnections" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock x:Name="LblCap" Text="Toplam limit — Sınırsız"
                                           Style="{StaticResource T.Meta}" Margin="0,0,0,5" />
                                <TextBox x:Name="TxtGlobalLimit" TextChanged="TxtGlobalLimit_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Arsivci ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="ARŞİVCİ" Style="{StaticResource T.Kicker}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbArchiver" Grid.Column="0" IsEditable="True" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Seç…"
                                    Click="BtnBrowseArchiver_Click" Margin="9,0,0,0" Padding="12,7" />
                        </Grid>
                        <TextBlock x:Name="TxtArchiverFound" Style="{StaticResource T.Meta}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ═══ Davranis ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="DAVRANIŞ" Style="{StaticResource T.Kicker}" Margin="0,0,0,8" />
                        <CheckBox x:Name="ChkAutoStart"
                                  Content="Windows açılışında indirme motorunu başlat" />
                        <CheckBox x:Name="ChkOpenFolderDefault"
                                  Content="İndirme bitince klasörü aç" />

                        <Rectangle Style="{StaticResource Hr}" />

                        <TextBlock Text="Ek aria2 ayarları (her satırda bir tane)"
                                   Style="{StaticResource T.Meta}" Margin="0,0,0,5" TextWrapping="Wrap" />
                        <TextBox x:Name="TxtExtraArgs" AcceptsReturn="True" Height="66"
                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                 FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                    </StackPanel>
                </Border>

                <!-- ═══ Motor ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="MOTOR" Style="{StaticResource T.Kicker}" Margin="0,0,0,10" />
                        <Grid>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,150,0">
                                <TextBlock x:Name="TxtEngineState" Text="—" FontSize="14" />
                                <TextBlock Text="Arka planda duran tek süreç aria2c. Durdurursan indirmeler de durur; yeni bir indirme başlattığında kendiliğinden geri gelir."
                                           Style="{StaticResource T.Meta}" Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="BtnEngine" Style="{StaticResource Btn.Secondary}"
                                    Content="Motoru durdur" Click="BtnEngine_Click"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    MinWidth="132" Padding="12,7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ Guvenlik ═══ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="GÜVENLİK" Style="{StaticResource T.Kicker}" Margin="0,0,0,10" />
                        <TextBlock x:Name="TxtSecurity" Style="{StaticResource T.Meta}" TextWrapping="Wrap" />
                        <Button Content="Motoru yeniden başlat" Style="{StaticResource Btn.Secondary}"
                                Click="BtnRestartEngine_Click" HorizontalAlignment="Left"
                                Margin="0,12,0,0" Padding="12,7" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="Akinti.Ui.PasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arşiv şifreli" Width="420" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        Foreground="{DynamicResource B.Text}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="16,14,16,16">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="44" Height="44"
                    VerticalAlignment="Center">
                <TextBlock Text="&#xE72E;" Style="{StaticResource T.Icon}" FontSize="17"
                           Foreground="{DynamicResource B.Accent}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtName" Text="—" FontSize="15" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Bu arşiv şifreli. Çıkarmak için şifresini gir."
                           Style="{StaticResource T.Meta}" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <PasswordBox x:Name="TxtPassword" Margin="0,14,0,0" KeyDown="TxtPassword_KeyDown" />

        <TextBlock x:Name="TxtError" Visibility="Collapsed" Margin="2,8,0,0" FontSize="12"
                   TextWrapping="Wrap" Foreground="{DynamicResource B.Danger}"
                   Text="Şifre yanlış. Tekrar dene." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Style="{StaticResource Btn.Secondary}" Content="Vazgeç" Click="BtnCancel_Click"
                    IsCancel="True" MinWidth="86" Padding="12,7" Margin="0,0,9,0" />
            <Button x:Name="BtnOk" Style="{StaticResource Btn.Primary}" Content="Çıkar" Click="BtnOk_Click"
                    IsDefault="True" MinWidth="86" Padding="12,7" />
        </StackPanel>

    </StackPanel>
</Window>

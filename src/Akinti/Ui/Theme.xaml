<!--
  Akinti'nin tasarim sistemi: Windows 11 (Fluent) olculeri ve davranisi.
  Renkler ThemeManager'dan gelir, sistemin acik/koyu temasini ve vurgu rengini
  izler. Olcu/kose/tipografi degisikligi buradan yapilir, pencere XAML'lerine
  dokunmaya gerek yok.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
      Renk paleti burada DEGIL: ThemeManager.cs Windows'un tema ve vurgu rengi
      ayarindan uretip calisma aninda ekliyor. Bu yuzden tum renkler asagida
      DynamicResource ile aliniyor - kullanici Windows temasini degistirince
      acik pencereler de doner.
    -->

    <!-- ══════════════ Olcu token'lari ══════════════ -->
    <sys:Double x:Key="S1">2.8</sys:Double>
    <sys:Double x:Key="S2">5.6</sys:Double>
    <sys:Double x:Key="S3">8.4</sys:Double>
    <sys:Double x:Key="S4">11.2</sys:Double>
    <sys:Double x:Key="S6">16.8</sys:Double>
    <sys:Double x:Key="S8">22.4</sys:Double>

    <CornerRadius x:Key="R.Sm">4</CornerRadius>
    <CornerRadius x:Key="R.Md">8</CornerRadius>
    <CornerRadius x:Key="R.Lg">14</CornerRadius>
    <CornerRadius x:Key="R.Tag">6</CornerRadius>

    <FontFamily x:Key="F.Ui">Inter, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ══════════════ Tipografi ══════════════ -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="T.H4" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="T.Muted" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="T.Meta" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- .card-kicker: 10px, harf araligi genis, buyuk harf, accent -->
    <Style x:Key="T.Kicker" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <!-- Kenar cubugu bolum basligi: AKTARIMLAR -->
    <Style x:Key="T.SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextFaint}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Rakamlarin genisligi sabit kalsin: hiz/yuzde titremesin -->
    <Style x:Key="T.Num" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
    </Style>

    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icon}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Auto" />
    </Style>

    <!-- ══════════════ Dugmeler (.btn) ══════════════ -->
    <Style x:Key="Btn.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5.6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Md}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .btn-primary: accent yazi + accent cerceve, DOLGU YOK -->
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.HoverAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Secondary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{DynamicResource B.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.HoverText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
        <Setter Property="Padding" Value="2.8,5.6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.GhostHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- .btn-ghost.btn-icon: 36x36 kare, satir ici eylemler -->
    <Style x:Key="Btn.Icon" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource B.HoverText}" />
                <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Baslik cubugu dugmeleri: kapat kirmiziya doner -->
    <Style x:Key="Btn.Caption" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.HoverText}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.DangerHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kenar cubugu gezinme ogesi: ikon + etiket + sayac rozeti -->
    <Style x:Key="Nav.Item" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="{StaticResource R.Md}"
                            Padding="10,8">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.HoverSubtle}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Girdi (.input) ══════════════ -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CaretBrush" Value="{DynamicResource B.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource B.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource R.Md}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.InputHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Kart (.card / .elev-sm) ══════════════ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Md}" />
        <Setter Property="Padding" Value="8.4" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Neutral800}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Satir kabi: kart degil, arka plansiz, uzerine gelince hafif doluyor -->
    <Style x:Key="RowShell" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Md}" />
        <Setter Property="Padding" Value="8.4,8.4" />
    </Style>

    <!-- Dosya turu karesi: satir basindaki 36x36 ikon kutusu -->
    <Style x:Key="FileTile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{DynamicResource B.Surface}" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Md}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ══════════════ Rozet (.tag) ══════════════ -->
    <Style x:Key="Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource R.Tag}" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource B.Neutral800}" />
    </Style>

    <Style x:Key="T.TagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource C.Neutral100}" />
    </Style>

    <!-- ══════════════ Ayirici (.hr) — iki ucu sonumleniyor ══════════════ -->
    <Style x:Key="Hr" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,11.2" />
        <Setter Property="Fill" Value="{DynamicResource B.Divider}" />
    </Style>

    <!-- ══════════════ Ilerleme cubugu ══════════════ -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Background" Value="{DynamicResource B.TrackDim}" />
        <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!-- PART_Track sart: ProgressBar gostergenin genisligini ona gore
                         hesapliyor. Yoksa dolgu hic cizilmiyor, sadece yol gorunuyor. -->
                    <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                        <Grid>
                            <Rectangle x:Name="PART_Track" Fill="Transparent" />
                            <Rectangle x:Name="PART_Indicator" Fill="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Left" RadiusX="2" RadiusY="2" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disk doluluk cubugu (kenar cubugu alti) -->
    <Style x:Key="Bar.Disk" TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource B.Accent2}" />
    </Style>

    <!-- ══════════════ Kaydirma cubugu ══════════════ -->
    <Style x:Key="Sb.Thumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="bd" Background="{DynamicResource B.Neutral800}" CornerRadius="5"
                            Margin="2,0" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.Neutral700}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="9" />
        <Setter Property="MinWidth" Value="9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Sb.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="9" />
                            <Setter Property="MinHeight" Value="9" />
                            <Setter Property="Width" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Onay kutusu ══════════════ -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Margin" Value="0,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="{StaticResource R.Sm}"
                                Background="{DynamicResource B.Surface}"
                                BorderBrush="{DynamicResource B.Divider}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}"
                                       FontSize="11" Foreground="{DynamicResource B.Accent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="{TemplateBinding FontSize}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource B.InputHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Acilir liste ══════════════ -->
    <Style x:Key="Cmb.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="chev" Text="&#xE70D;" FontFamily="{StaticResource F.Icon}"
                                   FontSize="10" Foreground="{DynamicResource B.TextFaint}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,11,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                            CornerRadius="{StaticResource R.Sm}" Margin="3,1">
                        <ContentPresenter TextElement.Foreground="{DynamicResource B.Text}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.HoverAccent}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
        <Setter Property="Background" Value="{DynamicResource B.ControlFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource B.ControlStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource R.Md}" />

                        <ToggleButton Style="{StaticResource Cmb.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                  RelativeSource={RelativeSource TemplatedParent}}" />

                        <TextBox x:Name="PART_EditableTextBox" Margin="1,1,28,1"
                                 Padding="{TemplateBinding Padding}"
                                 Background="Transparent" BorderThickness="0" MinHeight="0"
                                 Foreground="{DynamicResource B.Text}"
                                 CaretBrush="{DynamicResource B.Accent}"
                                 SelectionBrush="{DynamicResource B.Accent}"
                                 VerticalContentAlignment="Center" Visibility="Collapsed" />

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{DynamicResource B.Text}"
                                          TextElement.FontSize="14" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{DynamicResource B.Bg}"
                                    BorderBrush="{DynamicResource B.Neutral800}" BorderThickness="1"
                                    CornerRadius="{StaticResource R.Md}" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.InputHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Segmentli secim (.seg / .seg-opt) ══════════════ -->
    <Style x:Key="Seg" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource B.Divider}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource R.Md}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Seg.Opt" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource B.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinWidth" Value="46" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" Padding="12,7"
                            CornerRadius="{StaticResource R.Sm}" Margin="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          TextElement.FontSize="13" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.HoverText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.Accent}" />
                            <Setter TargetName="bd" Property="BorderThickness" Value="1" />
                            <Setter TargetName="bd" Property="Margin" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Kaydirici (hiz siniri) ══════════════ -->
    <Style TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource B.TrackDim}" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2"
                                                    Background="{DynamicResource B.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{DynamicResource B.Accent}" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════ Liste ══════════════ -->
    <Style x:Key="List.Plain" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

</ResourceDictionary>

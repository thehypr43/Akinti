<Window x:Class="HafifDM.Ui.TorrentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Torrent dosyaları" Height="540" Width="680" MinHeight="380" MinWidth="520"
        Icon="/hafifdm.ico"
        Background="{StaticResource B.Bg}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel>

        <Border DockPanel.Dock="Top" Height="46" Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                               Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="Torrent dosyaları" Margin="10,0,0,0" FontSize="15" FontWeight="Medium"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Btn.CaptionClose}" Click="BtnClose_Click"
                        HorizontalAlignment="Right">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="20,14,20,18">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Style="{StaticResource Btn.Secondary}" Content="Tümünü seç" Click="BtnAll_Click"
                        Margin="0,0,9,0" Padding="12,7" />
                <Button Style="{StaticResource Btn.Secondary}" Content="Hiçbirini" Click="BtnNone_Click"
                        Padding="12,7" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Secondary}" Content="Kapat" Click="BtnClose_Click"
                        MinWidth="88" Padding="12,7" Margin="0,0,9,0" />
                <Button x:Name="BtnApply" Style="{StaticResource Btn.Primary}" Content="Seçimi uygula"
                        Click="BtnApply_Click" IsEnabled="False" MinWidth="118" Padding="12,7" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Margin="20,0,20,14">
            <TextBlock x:Name="TxtTitle" Style="{StaticResource T.H4}"
                       Text="Torrent bilgileri bekleniyor…" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="TxtSub" Style="{StaticResource T.Muted}" Margin="0,3,0,0" TextWrapping="Wrap"
                       Text="İndirme sürüyor. Dosya listesi gelir gelmez burada görünecek; seçim yapmazsanız tüm dosyalar iner." />
        </StackPanel>

        <Border Style="{StaticResource Card}" Margin="20,0,20,0" Padding="4">
            <ListBox x:Name="ListFiles" Style="{StaticResource List.Plain}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="bd" Background="Transparent" Padding="8,4"
                                            CornerRadius="{StaticResource R.Sm}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#0AE9E9ED" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      Content="{Binding Display}" VerticalAlignment="Center" Margin="0" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                       Style="{StaticResource T.Meta}" Margin="12,0,4,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>

<Window x:Class="Akinti.Ui.DoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İndirme tamamlandı" Width="356" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Mica}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Tasarimdaki "İndirme tamamlandı" diyalogu: ortalanmis yuvarlak sonuc
         isareti, altinda dosya karti, sonra dolu birincil dugme ve ikincil sira. -->
    <StackPanel Margin="22,14,22,22">

        <!-- ═══ Sonuç ═══ -->
        <StackPanel HorizontalAlignment="Center">
            <Border x:Name="Badge" Width="56" Height="56" CornerRadius="28"
                    Background="{DynamicResource B.Success}" HorizontalAlignment="Center">
                <TextBlock x:Name="IcoBadge" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}"
                           FontSize="24" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="TxtHeading" Text="İndirme tamamlandı" Margin="0,14,0,0"
                       FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="TxtSub" Style="{StaticResource T.Muted}" Margin="0,5,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="290" />
        </StackPanel>

        <!-- ═══ Dosya ═══ -->
        <Border Style="{StaticResource Card}" Margin="0,18,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="36" Height="36">
                    <TextBlock x:Name="TxtKind" Text="DSY" Style="{StaticResource T.FileKind}" FontSize="9" />
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtName" Text="—" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ Hata ═══ -->
        <Border x:Name="PnlError" Visibility="Collapsed" Margin="0,12,0,0" Padding="12,10"
                CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.DangerHover}">
            <TextBlock x:Name="TxtError" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource B.Danger}" />
        </Border>

        <TextBlock x:Name="TxtNote" Style="{StaticResource T.Meta}" Margin="0,12,0,0"
                   TextAlignment="Center" TextTrimming="CharacterEllipsis" />

        <!-- ═══ Eylemler ═══ -->
        <StackPanel Margin="0,16,0,0">
            <Button x:Name="BtnOpenFile" Style="{StaticResource Btn.Primary}" Content="Dosyayı aç"
                    Height="34" MinHeight="34" IsDefault="True" Click="BtnOpenFile_Click" />

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnOpenFolder" Style="{StaticResource Btn.Secondary}"
                        Content="Klasörde göster" Height="34" MinHeight="34" Margin="0,0,8,0"
                        Click="BtnOpenFolder_Click" />
                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="Kapat"
                        Height="34" MinHeight="34" Padding="16,0" IsCancel="True" Click="BtnClose_Click" />
            </Grid>

            <!-- Dosya turu izin veriyorsa cikan ek isler -->
            <Grid x:Name="PnlExtra" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnExtract" Style="{StaticResource Btn.Secondary}"
                        Content="Klasöre çıkar" Height="34" MinHeight="34" Margin="0,0,8,0"
                        Visibility="Collapsed" Click="BtnExtract_Click" />
                <Button Grid.Column="1" x:Name="BtnRunAdmin" Style="{StaticResource Btn.Secondary}"
                        Content="Yönetici olarak aç" Height="34" MinHeight="34"
                        Visibility="Collapsed" Click="BtnRunAdmin_Click" />
            </Grid>
        </StackPanel>

    </StackPanel>
</Window>

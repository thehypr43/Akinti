<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>Akinti</AssemblyName>
    <RootNamespace>Akinti</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>akinti.ico</ApplicationIcon>

    <!-- Boyut onemsiz, acilis hizi onemli: self-contained + ReadyToRun -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>

    <!-- Turkce kultur gerekli, invariant globalization kapali -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en;tr</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF'in ImplicitUsings kumesi System.IO icermiyor, her dosyada lazim. -->
    <Using Include="System.IO" />

    <!-- ApplicationIcon sadece exe ikonunu ayarlar. Pencerelerdeki
         Icon="/akinti.ico" bagi icin dosyanin ayrica kaynak olarak
         gomulmesi gerekiyor, yoksa her pencere acilirken XamlParseException. -->
    <None Remove="akinti.ico" />
    <Resource Include="akinti.ico" />
  </ItemGroup>

</Project>

<Window x:Class="Akinti.Ui.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bağlantı yakalandı" Width="468" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <StackPanel Margin="16,14,16,16">

        <!-- ═══ Dosya ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FileTile}" Width="44" Height="44"
                    VerticalAlignment="Center">
                <TextBlock x:Name="IcoFile" Text="&#xE7C3;" Style="{StaticResource T.Icon}"
                           FontSize="17" Foreground="{DynamicResource B.Accent}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtFileTitle" Text="—" FontSize="15" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtSize" Text="Boyut sorgulanıyor…"
                           Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ═══ Elle girilen indirme: adres + ad ═══ -->
        <StackPanel x:Name="PnlManual" Visibility="Collapsed" Margin="0,14,0,0">
            <TextBox x:Name="TxtUrl" TextChanged="TxtUrl_TextChanged"
                     TextWrapping="NoWrap" MaxLines="1" />
            <TextBox x:Name="TxtFileName" TextChanged="TxtFileName_TextChanged" Margin="0,8,0,0" />
        </StackPanel>

        <!-- ═══ Kayıt klasörü ═══ -->
        <Border Margin="0,14,0,0" Padding="12,9" CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.ControlFill}"
                BorderBrush="{DynamicResource B.ControlStroke}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE8B7;" FontFamily="{StaticResource F.Icon}"
                           FontSize="13" Foreground="{DynamicResource B.TextFaint}"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="TxtFolder" Margin="10,0,10,0" FontSize="13"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Değiştir"
                        Padding="6,2" Click="BtnBrowse_Click" />
            </Grid>
        </Border>

        <!-- ═══ Torrent ═══ -->
        <CheckBox x:Name="ChkPickFiles" Content="Bilgiler gelince indirilecek dosyaları seç"
                  IsChecked="True" Margin="2,12,0,0" Visibility="Collapsed" />

        <!-- ═══ Eylemler ═══ -->
        <Grid Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Meta}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,200,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLater" Style="{StaticResource Btn.Secondary}" Content="Sonra"
                        Click="BtnLater_Click" MinWidth="82" Padding="12,7" Margin="0,0,9,0" />
                <Button x:Name="BtnDownload" Style="{StaticResource Btn.Primary}" Click="BtnDownload_Click"
                        IsDefault="True" MinWidth="96" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="İndir" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>

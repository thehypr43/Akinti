<Window x:Class="HafifDM.Ui.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni indirme" Height="700" Width="660"
        MinHeight="520" MinWidth="560"
        Icon="/hafifdm.ico"
        Background="{StaticResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" ShowInTaskbar="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <DockPanel Margin="20">

        <!-- ===== Alt dugmeler ===== -->
        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Dim}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,240,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Iptal" Click="BtnCancel_Click" Margin="0,0,8,0" MinWidth="88" />
                <Button x:Name="BtnLater" Content="Sonra indir" Click="BtnLater_Click"
                        Margin="0,0,8,0" MinWidth="104" />
                <Button x:Name="BtnDownload" Style="{StaticResource Btn.Primary}" Content="Indir"
                        Click="BtnDownload_Click" IsDefault="True" MinWidth="96" />
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Sag kenar bosluğu: kaydirma cubugu icerigin uzerine binmesin -->
            <StackPanel Margin="0,0,14,0">

                <!-- ===== Kaynak ===== -->
                <TextBlock Text="Adres" Style="{StaticResource T.Dim}" Margin="2,0,0,5" />
                <TextBox x:Name="TxtUrl" TextChanged="TxtUrl_TextChanged"
                         TextWrapping="NoWrap" MaxLines="1" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Dosya adi"
                               Style="{StaticResource T.Dim}" Margin="2,0,0,5" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSize" Text="Boyut sorgulaniyor..."
                               Style="{StaticResource T.Dim}" Margin="12,0,2,5"
                               HorizontalAlignment="Right" />
                </Grid>
                <TextBox x:Name="TxtFileName" TextChanged="TxtFileName_TextChanged" />

                <!-- ===== Hedef ===== -->
                <TextBlock Text="Kayit klasoru" Style="{StaticResource T.Dim}" Margin="2,14,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbFolder" Grid.Column="0" IsEditable="True" />
                    <Button Grid.Column="1" Content="Gozat" Click="BtnBrowse_Click" Margin="8,0,0,0"
                            MinWidth="72" />
                </Grid>
                <TextBlock x:Name="TxtRuleHint" Style="{StaticResource T.Dim}" Margin="2,6,0,0"
                           TextWrapping="Wrap" />

                <!-- ===== Indirme sonrasi ===== -->
                <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="Indirme bitince" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkExtract" Content="Arsivi klasore cikar"
                                  Checked="ChkExtract_Changed" Unchecked="ChkExtract_Changed" />
                        <CheckBox x:Name="ChkDeleteArchive" Content="Cikardiktan sonra arsivi sil"
                                  Margin="24,2,0,5" IsEnabled="False" />

                        <CheckBox x:Name="ChkRunAdmin" Content="Yonetici olarak calistir"
                                  Checked="ChkRunAdmin_Changed" Unchecked="ChkRunAdmin_Changed" />
                        <TextBlock x:Name="TxtAdminWarn" Visibility="Collapsed" Margin="24,0,0,5"
                                   TextWrapping="Wrap" FontSize="12"
                                   Foreground="{StaticResource B.Warning}"
                                   Text="Bu dosya indikten sonra yonetici yetkisiyle calistirilacak ve Windows sana bir UAC onayi gosterecek. Sadece guvendigin kaynaklar icin isaretle." />

                        <CheckBox x:Name="ChkOpenFolder" Content="Klasoru ac" />
                        <TextBlock x:Name="TxtArchiverHint" Style="{StaticResource T.Dim}"
                                   Margin="24,4,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!-- ===== Baglanti ===== -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Baglanti sayisi" Style="{StaticResource T.Dim}" Margin="2,0,0,5" />
                            <ComboBox x:Name="CmbConnections" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="Hiz siniri (KB/sn, 0 = sinirsiz)" Style="{StaticResource T.Dim}"
                                       Margin="2,0,0,5" />
                            <TextBox x:Name="TxtSpeedLimit" Text="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Torrent ===== -->
                <Border x:Name="PnlTorrent" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Torrent" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Paylasim orani (seed ratio)" Style="{StaticResource T.Dim}"
                                   Margin="2,0,0,5" />
                        <TextBox x:Name="TxtSeedRatio" Text="1.0" MaxLength="6" />
                        <CheckBox x:Name="ChkPickFiles" Content="Bilgiler gelince indirilecek dosyalari sec"
                                  IsChecked="True" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>

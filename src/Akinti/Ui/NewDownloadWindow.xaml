<Window x:Class="Akinti.Ui.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bağlantı yakalandı" Width="428" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Mica}"
        Foreground="{DynamicResource B.Text}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Tasarimdaki "İndirme yakalandı" diyalogu: 428 genislik, 22px yan dolgu,
         basliktaki accent kare, alanlari etiketli tek bir kart, altta uc dugme. -->
    <StackPanel Margin="22,10,22,22">

        <!-- ═══ Başlık ═══ -->
        <!-- Yatay StackPanel cocuklarina sinirsiz genislik verdigi icin aciklama
             sarilmayip kenardan tasiyordu; Grid gercek bir sutun genisligi veriyor. -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" VerticalAlignment="Top"
                    Background="{DynamicResource B.Accent}">
                <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="19"
                           Foreground="{DynamicResource B.AccentText}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtHeading" Text="Yeni bir indirme algılandı"
                           Style="{StaticResource T.H5}" TextWrapping="Wrap" />
                <TextBlock Text="Tarayıcıdan gelen bağlantıyı bu yöneticiyle indirebilirsin."
                           Style="{StaticResource T.Muted}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- ═══ Dosya alanları ═══ -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="DOSYA ADI" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,5" />
                <TextBox x:Name="TxtFileName" TextChanged="TxtFileName_TextChanged" />

                <!-- Elle indirmede adres de duzenlenebilir olmali -->
                <StackPanel x:Name="PnlManual" Visibility="Collapsed" Margin="0,12,0,0">
                    <TextBlock Text="ADRES" Style="{StaticResource T.SectionLabel}" Margin="0,0,0,5" />
                    <TextBox x:Name="TxtUrl" TextChanged="TxtUrl_TextChanged"
                             TextWrapping="NoWrap" MaxLines="1" />
                </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="BOYUT" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtSize" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="TÜR" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtKind" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="KAYNAK" Style="{StaticResource T.SectionLabel}" />
                        <TextBlock x:Name="TxtSource" Text="—" Style="{StaticResource T.Value}"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="KONUM" Style="{StaticResource T.SectionLabel}" Margin="0,12,0,5" />
                <Border Background="{DynamicResource B.Card2}" BorderThickness="1"
                        BorderBrush="{DynamicResource B.ControlStroke}"
                        CornerRadius="{StaticResource R.Ctl}" Height="32" Padding="10,0,4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtFolder" FontSize="13"
                                   Foreground="{DynamicResource B.TextMuted}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="1" Style="{StaticResource Btn.Secondary}" Content="Gözat"
                                Height="24" MinHeight="24" Padding="10,0" FontSize="12"
                                Click="BtnBrowse_Click" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Meta}" Margin="2,10,0,0"
                   TextWrapping="Wrap" />

        <!-- ═══ Eylemler ═══ -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BtnDownload" Style="{StaticResource Btn.Primary}"
                    Content="İndir" Height="34" MinHeight="34" Margin="0,0,8,0"
                    IsDefault="True" Click="BtnDownload_Click" />
            <Button Grid.Column="1" x:Name="BtnLater" Style="{StaticResource Btn.Secondary}"
                    Content="Sonra indir" Height="34" MinHeight="34" Margin="0,0,8,0"
                    Click="BtnLater_Click" />
            <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="İptal"
                    Height="34" MinHeight="34" Padding="16,0" IsCancel="True" Click="BtnCancel_Click" />
        </Grid>

    </StackPanel>
</Window>

<Window x:Class="Akinti.Ui.DoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Akıntı" Width="468" SizeToContent="Height"
        Icon="/akinti.ico"
        Background="{DynamicResource B.Bg}"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <StackPanel Margin="16,10,10,16">

        <!-- ═══ Başlık ═══ -->
        <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent"
              Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="IcoState" Text="&#xE930;" FontFamily="{StaticResource F.Icon}"
                           FontSize="13" Foreground="{DynamicResource B.Accent}"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="TxtHeader" Text="İndirme tamamlandı" Margin="9,0,0,0"
                           FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
            </StackPanel>
            <Button Style="{StaticResource Btn.CaptionClose}" HorizontalAlignment="Right"
                    Width="32" Height="26" Click="BtnClose_Click">
                <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Button>
        </Grid>

        <!-- ═══ Dosya ═══ -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Width="50" Height="50" VerticalAlignment="Center">
                <Border Style="{StaticResource FileTile}" Width="44" Height="44"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <TextBlock x:Name="IcoFile" Text="&#xE7C3;" Style="{StaticResource T.Icon}"
                               FontSize="17" Foreground="{DynamicResource B.TextMuted}" />
                </Border>
                <!-- Kose rozeti: sonucun ne oldugu ikona da islensin -->
                <Border x:Name="Badge" Width="18" Height="18" CornerRadius="9"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Background="{DynamicResource B.Accent}">
                    <TextBlock x:Name="IcoBadge" Text="&#xE73E;" FontFamily="{StaticResource F.Icon}"
                               FontSize="9" Foreground="{DynamicResource B.AccentText}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>

            <StackPanel Grid.Column="1" Margin="14,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtName" Text="—" FontSize="15" FontWeight="Medium"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtMeta" Style="{StaticResource T.Meta}" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

        <!-- ═══ Ayrıntılar ═══ -->
        <Grid x:Name="PnlInfo" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="KONUM" Style="{StaticResource T.SectionLabel}" />
                <TextBlock x:Name="TxtLocation" Text="—" FontSize="13" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Row="0" Grid.Column="1">
                <TextBlock Text="KAYNAK" Style="{StaticResource T.SectionLabel}" />
                <TextBlock x:Name="TxtSource" Text="—" FontSize="13" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel x:Name="PnlDuration" Grid.Row="1" Grid.Column="0" Margin="0,14,12,0">
                <TextBlock Text="SÜRE" Style="{StaticResource T.SectionLabel}" />
                <TextBlock x:Name="TxtDuration" Text="—" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel x:Name="PnlSize" Grid.Row="1" Grid.Column="1" Margin="0,14,0,0">
                <TextBlock Text="BOYUT" Style="{StaticResource T.SectionLabel}" />
                <TextBlock x:Name="TxtSizeValue" Text="—" FontSize="13" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <!-- ═══ Hata ═══ -->
        <Border x:Name="PnlError" Visibility="Collapsed" Margin="0,16,0,0" Padding="12,10"
                CornerRadius="{StaticResource R.Md}"
                Background="{DynamicResource B.DangerHover}">
            <TextBlock x:Name="TxtError" TextWrapping="Wrap" FontSize="13"
                       Foreground="{DynamicResource B.Danger}" />
        </Border>

        <!-- ═══ Alt sıra ═══ -->
        <!-- Sira: Klasor, Klasore cikar, Yonetici ac, Ac. Ortadaki ikisi yalnizca
             dosya turu izin veriyorsa gorunur. -->
        <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Durum yazisi kendi sutununda: uzun bir ileti dugmelerin uzerine binmesin -->
            <TextBlock Grid.Column="0" x:Name="TxtNote" Style="{StaticResource T.Meta}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,10,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Secondary}"
                        Padding="12,7" Margin="0,0,8,0" Click="BtnOpenFolder_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Klasör" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnExtract" Style="{StaticResource Btn.Secondary}" Visibility="Collapsed"
                        Padding="12,7" Margin="0,0,8,0" Click="BtnExtract_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xF012;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Klasöre çıkar" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnRunAdmin" Style="{StaticResource Btn.Secondary}" Visibility="Collapsed"
                        Padding="12,7" Margin="0,0,8,0" Click="BtnRunAdmin_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7EF;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="Yönetici aç" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </StackPanel>
                </Button>

                <Button x:Name="BtnOpenFile" Style="{StaticResource Btn.Primary}" Content="Aç"
                        MinWidth="68" Padding="12,7" IsDefault="True" Click="BtnOpenFile_Click" />
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>

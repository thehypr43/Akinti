{
  "manifest_version": 3,
  "name": "HafifDM",
  "version": "1.0.0",
  "description": "Sag tik menusunden HafifDM ile indir. Sayfalara hicbir sekilde dokunmaz.",

  "permissions": ["contextMenus", "nativeMessaging"],

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

<Window x:Class="HafifDM.Ui.TorrentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Torrent dosyalari" Height="520" Width="660" MinHeight="380" MinWidth="520"
        Icon="/hafifdm.ico"
        Background="{StaticResource B.Bg}"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <DockPanel Margin="20">

        <TextBlock DockPanel.Dock="Top" x:Name="TxtTitle" Style="{StaticResource T.Title}"
                   Text="Torrent bilgileri bekleniyor..." TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" x:Name="TxtSub" Style="{StaticResource T.Dim}"
                   Margin="0,6,0,14" TextWrapping="Wrap"
                   Text="Indirme suruyor. Dosya listesi gelir gelmez burada gorunecek; secim yapmazsan tum dosyalar iner." />

        <Grid DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Tumunu sec"  Click="BtnAll_Click"  Margin="0,0,8,0" MinWidth="94" />
                <Button Content="Hicbirini"   Click="BtnNone_Click" MinWidth="94" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Kapat" Click="BtnClose_Click" Margin="0,0,8,0" MinWidth="88" />
                <Button x:Name="BtnApply" Style="{StaticResource Btn.Primary}" Content="Secimi uygula"
                        Click="BtnApply_Click" IsEnabled="False" MinWidth="118" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="ListFiles" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="6,3" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                      Content="{Binding Display}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                       Style="{StaticResource T.Dim}" Margin="12,0,4,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</Window>

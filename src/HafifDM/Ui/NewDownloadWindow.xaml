<Window x:Class="HafifDM.Ui.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Bağlantı yakalandı" Height="680" Width="560"
        MinHeight="520" MinWidth="480"
        Icon="/hafifdm.ico"
        Background="{StaticResource B.Bg}"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <DockPanel>

        <!-- ═══════ Baslik ═══════ -->
        <Border DockPanel.Dock="Top" Height="46" Background="Transparent"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71B;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                               Foreground="{StaticResource B.Accent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtDialogTitle" Text="Bağlantı yakalandı" Margin="10,0,0,0"
                               FontSize="15" FontWeight="Medium" VerticalAlignment="Center" />
                </StackPanel>
                <Button Style="{StaticResource Btn.CaptionClose}" Click="BtnCancel_Click"
                        HorizontalAlignment="Right">
                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource F.Icon}" FontSize="11"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Border>

        <!-- ═══════ Eylemler ═══════ -->
        <Grid DockPanel.Dock="Bottom" Margin="20,12,20,18">
            <TextBlock x:Name="TxtStatus" Style="{StaticResource T.Meta}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Margin="0,0,210,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnLater" Style="{StaticResource Btn.Secondary}" Content="Sonra"
                        Click="BtnLater_Click" MinWidth="86" Padding="12,7" Margin="0,0,9,0" />
                <Button x:Name="BtnDownload" Style="{StaticResource Btn.Primary}" Click="BtnDownload_Click"
                        IsDefault="True" MinWidth="96" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource F.Icon}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="İndir" Margin="7,0,0,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="Medium" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Margin="20,4,6,0">
            <StackPanel Margin="0,0,14,0">

                <!-- ═══════ Kaynak karti ═══════ -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource FileTile}" Width="42" Height="42"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="IcoFile" Text="&#xE7C3;" Style="{StaticResource T.Icon}"
                                           FontSize="18" Foreground="{StaticResource B.Accent}" />
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="380">
                                <TextBlock x:Name="TxtFileTitle" Text="—" FontSize="15" FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtSize" Text="Boyut sorgulanıyor…"
                                           Style="{StaticResource T.Meta}" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Style="{StaticResource Hr}" Margin="0,12" />

                        <TextBlock Text="Adres" Style="{StaticResource T.Meta}" Margin="0,0,0,5" />
                        <TextBox x:Name="TxtUrl" TextChanged="TxtUrl_TextChanged"
                                 TextWrapping="NoWrap" MaxLines="1" />

                        <TextBlock Text="Dosya adı" Style="{StaticResource T.Meta}" Margin="0,12,0,5" />
                        <TextBox x:Name="TxtFileName" TextChanged="TxtFileName_TextChanged" />
                    </StackPanel>
                </Border>

                <!-- ═══════ Hedef klasor ═══════ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource F.Icon}" FontSize="13"
                                       Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" />
                            <TextBlock Text="Kayıt klasörü" Margin="8,0,0,0" Style="{StaticResource T.Meta}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CmbFolder" Grid.Column="0" IsEditable="True" />
                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Content="Değiştir"
                                    Click="BtnBrowse_Click" Margin="10,0,0,0" Padding="10,7" />
                        </Grid>
                        <TextBlock x:Name="TxtRuleHint" Style="{StaticResource T.Meta}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" Foreground="{StaticResource B.Accent2}" />
                    </StackPanel>
                </Border>

                <!-- ═══════ Indirme sonrasi ═══════ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <StackPanel>
                        <TextBlock Text="İNDİRME BİTİNCE" Style="{StaticResource T.Kicker}"
                                   Margin="0,0,0,10" />

                        <CheckBox x:Name="ChkExtract" Content="Arşivi klasöre çıkar"
                                  Checked="ChkExtract_Changed" Unchecked="ChkExtract_Changed" />
                        <CheckBox x:Name="ChkDeleteArchive" Content="Çıkardıktan sonra arşivi sil"
                                  Margin="27,2,0,5" IsEnabled="False" />

                        <CheckBox x:Name="ChkRunAdmin" Content="Yönetici olarak çalıştır"
                                  Checked="ChkRunAdmin_Changed" Unchecked="ChkRunAdmin_Changed" />
                        <Border x:Name="PnlAdminWarn" Visibility="Collapsed" Margin="27,2,0,6"
                                Background="#1FE06C75" CornerRadius="{StaticResource R.Sm}" Padding="10,8">
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="{StaticResource B.Danger}"
                                       Text="Bu dosya indikten sonra yönetici yetkisiyle çalıştırılacak ve Windows bir UAC onayı gösterecek. Sadece güvendiğin kaynaklar için işaretle." />
                        </Border>

                        <CheckBox x:Name="ChkOpenFolder" Content="Klasörü aç" />

                        <TextBlock x:Name="TxtArchiverHint" Style="{StaticResource T.Meta}"
                                   Margin="27,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                   Foreground="{StaticResource B.Danger}" />
                    </StackPanel>
                </Border>

                <!-- ═══════ Baglanti ═══════ -->
                <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Bağlantı sayısı" Style="{StaticResource T.Meta}"
                                       Margin="0,0,0,5" />
                            <ComboBox x:Name="CmbConnections" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Hız sınırı (KB/sn, 0 = sınırsız)" Style="{StaticResource T.Meta}"
                                       Margin="0,0,0,5" />
                            <TextBox x:Name="TxtSpeedLimit" Text="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ═══════ Torrent ═══════ -->
                <Border x:Name="PnlTorrent" Style="{StaticResource Card}" Margin="0,12,0,0"
                        Padding="14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="TORRENT" Style="{StaticResource T.Kicker}" Margin="0,0,0,10" />
                        <TextBlock Text="Paylaşım oranı" Style="{StaticResource T.Meta}" Margin="0,0,0,5" />
                        <TextBox x:Name="TxtSeedRatio" Text="1.0" MaxLength="6" />
                        <CheckBox x:Name="ChkPickFiles" Content="Bilgiler gelince indirilecek dosyaları seç"
                                  IsChecked="True" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
